{
  "hooks": {
    "Stop": [{
      "hooks": [{"type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/src/cli.ts start", "timeout": 5}]
    }],
    "PermissionRequest": [{
      "hooks": [{"type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/src/cli.ts start", "timeout": 5}]
    }],
    "UserPromptSubmit": [{
      "hooks": [{"type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/src/cli.ts stop", "timeout": 5}]
    }],
    "PreToolUse": [{
      "hooks": [{"type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/src/cli.ts stop", "timeout": 5}]
    }],
    "SessionEnd": [{
      "hooks": [{"type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/src/cli.ts stop", "timeout": 5}]
    }]
  }
}
